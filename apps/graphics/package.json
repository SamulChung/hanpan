{
  "name": "@genoffice/graphics",
  "productName": "GenOffice Graphics",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI Photo and AI Illustration editor module: the PhotoCraft and VectorCraft web builds in a shell tab, driven by the AI assistant through their page API",
  "main": "out/main/index.js",
  "scripts": {
    "web": "node ../../tools/fetch-graphics-web.mjs",
    "dev": "npm run web && electron-vite dev",
    "dev:renderer": "npm run web && vite --config vite.renderer.config.ts",
    "build": "npm run web && electron-vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/i18n": "*",
    "@genoffice/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "GenOffice"
}
